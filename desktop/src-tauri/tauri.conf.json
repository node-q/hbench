{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Actuaria Studio Essentials",
  "mainBinaryName": "Actuaria",
  "version": "0.5.0-beta.1",
  "identifier": "io.actuaria.studio",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "publisher": "NODEQ",
    "copyright": "© 2026 NODEQ",
    "shortDescription": "Expert-verified AI agent benchmarking studio",
    "longDescription": "Actuaria.io tests in-house agents and vendor AI products on your own real work. Built on hbench by node-q.",
    "externalBin": ["binaries/hbench"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": { "conflicts": ["actuaria"], "replaces": ["actuaria"] },
      "rpm": { "obsoletes": ["actuaria"] }
    },
    "windows": {
      "nsis": { "installerHooks": "windows/hooks.nsh" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0OTY1OEQ1QUUxMDI2OTkKUldTWkpoQ3UxVmlXOU9DV3l5ZU9MOWp3YWxrMXNzY0xzM0Erb3lhVHVmQ0F1bURIRkpsbW1md3cK",
      "endpoints": [
        "https://github.com/node-q/hbench/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
