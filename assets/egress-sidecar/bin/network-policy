#!/bin/sh
set -eu

# ALLOWLIST, GOST_PORT, and GOST_MARK must stay in sync with the literals in
# gost.yaml (file.path, addr, so_mark), which cannot read environment variables.
ALLOWLIST=/opt/egress-sidecar/allowlist.txt
GOST_PORT=12345
GOST_MARK=114514
NFTABLES_RULESET_NAME=gost_egress
# Must exceed the allowlist `reload: 1s` interval in gost.yaml so gost has
# picked up the new allowlist before nftables enforcement turns on.
RELOAD_WAIT=2
# nft+proxy: nftables sends all TCP through gost. proxy: the task container sits on an
# internal network, so the HTTP proxy is its only way out and nftables is not used.
METHOD="${EGRESS_CONTROL_METHOD:-nft+proxy}"

usage() {
  cat <<'EOF'
Usage:
  network-policy show
  network-policy allow-all
  network-policy deny-all
  network-policy allow [TARGET...]
  network-policy rules
  network-policy check-nftables

TARGET can be a domain, wildcard domain, IP, CIDR, or IP range. With no targets,
allow mode denies all controlled TCP egress.
EOF
}

ensure_file() {
  mkdir -p "$(dirname "$ALLOWLIST")"
  touch "$ALLOWLIST"
}

# Docker DNATs queries to the compose gateway:53 onto 127.0.0.11, so
# `fib daddr type local` (re-evaluated after DNAT) already allows resolver
# traffic. Podman aardvark-dns / pasta listen on the network gateway
# (e.g. 10.89.x.1) with no such DNAT, and the filter chain would reject
# UDP/TCP 53 (`meta l4proto != tcp reject`). Permit DNS only to nameservers
# listed in resolv.conf — the same trust boundary Docker's embedded resolver
# has. Hostname allowlisting still happens in gost via SNI.
nft_dns_rules() {
  family="$1"
  action="$2"
  awk -v family="$family" -v action="$action" '
    /^nameserver[[:space:]]+/ {
      ns = $2
      sub(/%.*/, "", ns)
      if (family == "ip" && ns ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
        printf "    ip daddr %s udp dport 53 %s\n", ns, action
        printf "    ip daddr %s tcp dport 53 %s\n", ns, action
      } else if (family == "ip6" && ns ~ /:/) {
        printf "    ip6 daddr %s udp dport 53 %s\n", ns, action
        printf "    ip6 daddr %s tcp dport 53 %s\n", ns, action
      }
    }
  ' /etc/resolv.conf
}

# One table per family rather than one inet table: `fib` in an inet table needs
# CONFIG_NFT_FIB_INET, which Docker Desktop's kernel lacks, while the ip and ip6
# variants (CONFIG_NFT_FIB_IPV4/IPV6) are there.
nft_ruleset() {
  family="$1"
  if [ "$family" = ip ]; then icmp="ip protocol icmp accept"; else icmp="ip6 nexthdr icmpv6 accept"; fi
  cat <<EOF
add table $family $NFTABLES_RULESET_NAME
flush table $family $NFTABLES_RULESET_NAME

table $family $NFTABLES_RULESET_NAME {
  chain output {
    type nat hook output priority dstnat; policy accept;

    meta mark $GOST_MARK return
    fib daddr type local return
$(nft_dns_rules "$family" return)
    meta l4proto tcp redirect to :$GOST_PORT
  }

  chain egress {
    type filter hook output priority filter; policy accept;

    meta mark $GOST_MARK accept
    fib daddr type local accept
$(nft_dns_rules "$family" accept)
    $icmp
    meta l4proto != tcp reject
  }
}
EOF
}

setup_nftables() {
  [ "$METHOD" = proxy ] && return
  { nft_ruleset ip; nft_ruleset ip6; } | nft --file -
}

remove_nftables() {
  [ "$METHOD" = proxy ] && return
  nft delete table ip "$NFTABLES_RULESET_NAME" 2>/dev/null || true
  nft delete table ip6 "$NFTABLES_RULESET_NAME" 2>/dev/null || true
}

nftables_enabled() {
  [ "$METHOD" = proxy ] && return 1
  nft list table ip "$NFTABLES_RULESET_NAME" >/dev/null 2>&1
}

show() {
  if nftables_enabled; then
    echo "mode: controlled egress"
  else
    echo "mode: allow-all (transparent proxy disabled)"
  fi
  echo "allowlist: $ALLOWLIST"
  if [ ! -s "$ALLOWLIST" ]; then
    if nftables_enabled; then
      echo "(empty: deny all controlled TCP egress)"
    else
      echo "(empty)"
    fi
    return
  fi
  nl --body-numbering=a "$ALLOWLIST"
}

wait_reload() {
  sleep "$RELOAD_WAIT"
}

ensure_file

cmd="${1:-}"
case "$cmd" in
  show)
    show
    ;;
  allow-all)
    remove_nftables
    # The HTTP proxy stays in use, so it must pass everything.
    printf '%s\n' '*' 0.0.0.0/0 ::/0 > "$ALLOWLIST"
    wait_reload
    echo "ok: allow all egress"
    ;;
  deny-all)
    : > "$ALLOWLIST"
    wait_reload
    setup_nftables
    echo "ok: deny all controlled TCP egress"
    ;;
  allow)
    shift
    : > "$ALLOWLIST"
    for item in "$@"; do
      if [ -n "$item" ]; then
        printf '%s\n' "$item" >> "$ALLOWLIST"
      fi
    done
    wait_reload
    setup_nftables
    echo "ok: allowlist applied"
    show
    ;;
  check-nftables)
    # Whether this kernel takes the ruleset (run in a throwaway container).
    setup_nftables
    remove_nftables
    echo "ok: nftables ruleset loads"
    ;;
  rules)
    if nftables_enabled; then
      nft list table ip "$NFTABLES_RULESET_NAME"
      nft list table ip6 "$NFTABLES_RULESET_NAME"
    else
      echo "mode: allow-all"
    fi
    ;;
  *)
    usage
    exit 2
    ;;
esac
