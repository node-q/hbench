          "title": "Load Trajectory"
        },
        "extra_allowed_hosts": {
          "description": "Run-specific hostnames or IP addresses merged into the effective agent phase allowlist during agent.run() only.",
          "items": {
            "type": "string"
          },
          "title": "Extra Allowed Hosts",
          "type": "array"
        },
        "include_logs": {
          "description": "Glob patterns of agent log files to download, relative to the agent logs directory. When set, only matching files are kept.",
          "items": {
            "type": "string"
          },
          "title": "Include Logs",
          "type": "array"
        },
        "exclude_logs": {
          "description": "Glob patterns of agent log files to skip when downloading. Applied after include_logs, so exclude wins on overlap.",
          "items": {
            "type": "string"
          },
          "title": "Exclude Logs",
          "type": "array"
        },
        "kwargs": {
          "additionalProperties": true,
          "title": "Kwargs",
          "type": "object"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env",
          "type": "object"
        },
        "mcp_servers": {
          "items": {
            "$ref": "#/$defs/MCPServerConfig"
          },
          "title": "Mcp Servers",
          "type": "array"
        },
        "user_persona_path": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Persona Path"
        },
        "user_prompt_template_path": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Prompt Template Path"
        },
        "bridge": {
          "$ref": "#/$defs/BridgeConfig"
        }
      },
      "required": [
        "bridge"
      ],
      "title": "UserAgentConfig",
      "type": "object"
    },
    "VerifierConfig": {
      "properties": {
        "override_timeout_sec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Override Timeout Sec"
        },
        "max_timeout_sec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
