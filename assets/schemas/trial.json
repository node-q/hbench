{
  "$defs": {
    "AgentConfig": {
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "import_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Import Path"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "n_concurrent": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-agent cap on concurrent agent.run() phases. Must not exceed the job's n_concurrent_trials and is usually useful only when lower. When omitted, agent execution is only limited by n_concurrent_trials.",
          "title": "N Concurrent"
        },
        "concurrency_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional shared concurrency pool name for agent configs that should use the same n_concurrent limit.",
          "title": "Concurrency Group"
        },
        "skills": {
          "description": "Skill directories or source strings (git URLs, org/name[@ref] shorthand, or local paths). Job.create() / Trial.create() resolve any non-local entries to cached directories in-place.",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "format": "path",
                "type": "string"
              }
            ]
          },
          "title": "Skills",
          "type": "array"
        },
        "override_timeout_sec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Override Timeout Sec"
        },
        "override_setup_timeout_sec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Override Setup Timeout Sec"
        },
        "max_timeout_sec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Timeout Sec"
        },
        "resume_trajectory": {
          "default": false,
          "description": "For multi-step tasks, resume the agent's native session from the previous step instead of starting a fresh conversation on each step. Requires an agent with native resume support (capabilities.resume); the trial fails fast otherwise. No effect on single-step tasks.",
          "title": "Resume Trajectory",
          "type": "boolean"
        },
        "load_trajectory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path to a trajectory to load as the agent's session before the first step, which then resumes it instead of starting fresh. A .jsonl file is the agent's native session format (lossless, same agent only; capabilities.load_native_trajectory); a .json file is an ATIF trajectory converted to the agent's native format (portable across supported agents; capabilities.load_atif_trajectory). The trial fails fast if the agent lacks the needed support. Composes with resume_trajectory.",
          "title": "Load Trajectory"
        },
        "extra_allowed_hosts": {
          "description": "Run-specific hostnames or IP addresses merged into the effective agent phase allowlist during agent.run() only.",
          "items": {
            "type": "string"
          },
          "title": "Extra Allowed Hosts",
          "type": "array"
        },
        "include_logs": {
          "description": "Glob patterns of agent log files to download, relative to the agent logs directory. When set, only matching files are kept.",
          "items": {
            "type": "string"
          },
          "title": "Include Logs",
          "type": "array"
        },
        "exclude_logs": {
          "description": "Glob patterns of agent log files to skip when downloading. Applied after include_logs, so exclude wins on overlap.",
          "items": {
            "type": "string"
          },
          "title": "Exclude Logs",
          "type": "array"
        },
        "kwargs": {
          "additionalProperties": true,
          "title": "Kwargs",
          "type": "object"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env",
          "type": "object"
        },
        "mcp_servers": {
          "items": {
            "$ref": "#/$defs/MCPServerConfig"
          },
          "title": "Mcp Servers",
          "type": "array"
        }
      },
      "title": "AgentConfig",
      "type": "object"
    },
    "ArtifactConfig": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "destination": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination"
        },
        "exclude": {
          "description": "Patterns to exclude when downloading a directory artifact (passed as tar --exclude flags).",
          "items": {
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        },
        "service": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Docker Compose service to collect this artifact from. None or 'main' targets the agent's container. Any other value requires a compose-capable environment provider and an absolute source path.",
          "title": "Service"
        }
      },
      "required": [
        "source"
      ],
      "title": "ArtifactConfig",
      "type": "object"
    },
    "BridgeConfig": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/BridgeKind"
        },
        "prompt_path": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Path"
        },
        "kwargs": {
          "additionalProperties": true,
          "title": "Kwargs",
          "type": "object"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BridgeConfig",
      "type": "object"
    },
    "BridgeKind": {
      "enum": [
        "acp"
      ],
      "title": "BridgeKind",
      "type": "string"
    },
    "EnvironmentConfig": {
      "properties": {
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvironmentType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "import_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Import Path"
        },
        "force_build": {
          "default": false,
          "title": "Force Build",
          "type": "boolean"
        },
        "delete": {
          "default": true,
          "title": "Delete",
          "type": "boolean"
        },
        "stream": {
          "default": false,
          "title": "Stream",
          "type": "boolean"
        },
        "cpu_enforcement_policy": {
          "$ref": "#/$defs/ResourceMode",
          "default": "auto"
        },
        "memory_enforcement_policy": {
          "$ref": "#/$defs/ResourceMode",
          "default": "auto"
        },
        "override_cpus": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Override Cpus"
        },
        "override_memory_mb": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Override Memory Mb"
        },
        "override_storage_mb": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Override Storage Mb"
        },
        "override_gpus": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Override Gpus"
        },
        "override_tpu": {
          "anyOf": [
            {
              "$ref": "#/$defs/TpuSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "suppress_override_warnings": {
          "default": false,
          "description": "Deprecated; has no effect.",
          "title": "Suppress Override Warnings",
          "type": "boolean"
        },
        "mounts": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ServiceVolumeConfig"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Additional mounts for the agent environment only.",
          "title": "Mounts"
        },
        "extra_docker_compose": {
          "description": "Additional Docker Compose overlays for the agent environment only.",
          "items": {
            "format": "path",
            "type": "string"
          },
          "title": "Extra Docker Compose",
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env",
          "type": "object"
        },
        "kwargs": {
          "additionalProperties": true,
          "title": "Kwargs",
          "type": "object"
        },
        "extra_allowed_hosts": {
          "description": "Run-specific hostnames or IP addresses merged into the [environment] network baseline at agent env start.",
          "items": {
            "type": "string"
          },
          "title": "Extra Allowed Hosts",
          "type": "array"
        }
      },
      "title": "EnvironmentConfig",
      "type": "object"
    },
    "EnvironmentType": {
      "enum": [
        "docker",
        "podman",
        "daytona",
        "e2b",
        "modal",
        "runloop",
        "langsmith",
        "ec2",
        "gke",
        "ack",
        "openshift",
        "novita",
        "apple-container",
        "singularity",
        "islo",
        "tensorlake",
        "cwsandbox",
        "use-computer",
        "cua-cloud",
        "blaxel",
        "opensandbox",
        "beam",
        "skypilot",
        "hf-sandbox",
        "hyperbrowser",
        "vercel",
        "runta",
        "prime",
        "kata",
        "mosaic",
        "smol",
        "sail"
      ],
      "title": "EnvironmentType",
      "type": "string"
    },
    "MCPServerConfig": {
      "description": "Configuration for an MCP server available to the agent.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "transport": {
          "default": "sse",
          "enum": [
            "stdio",
            "sse",
            "streamable-http"
          ],
          "title": "Transport",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "args": {
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "MCPServerConfig",
      "type": "object"
    },
    "ResourceMode": {
      "enum": [
        "auto",
        "limit",
        "request",
        "guarantee",
        "ignore"
      ],
      "title": "ResourceMode",
      "type": "string"
    },
    "ServiceVolumeBind": {
      "properties": {
        "create_host_path": {
          "const": false,
          "title": "Create Host Path",
          "type": "boolean"
        },
        "selinux": {
          "enum": [
            "z",
            "Z"
          ],
          "title": "Selinux",
          "type": "string"
        }
      },
      "title": "ServiceVolumeBind",
      "type": "object"
    },
    "ServiceVolumeConfig": {
      "properties": {
        "type": {
          "enum": [
            "bind",
            "volume",
            "image"
          ],
          "title": "Type",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "read_only": {
          "const": true,
          "title": "Read Only",
          "type": "boolean"
        },
        "bind": {
          "$ref": "#/$defs/ServiceVolumeBind"
        },
        "volume": {
          "$ref": "#/$defs/ServiceVolumeVolume"
        },
        "image": {
          "$ref": "#/$defs/ServiceVolumeImage"
        }
      },
      "required": [
        "type",
        "source",
        "target"
      ],
      "title": "ServiceVolumeConfig",
      "type": "object"
    },
    "ServiceVolumeImage": {
      "properties": {
        "subpath": {
          "title": "Subpath",
          "type": "string"
        }
      },
      "title": "ServiceVolumeImage",
      "type": "object"
    },
    "ServiceVolumeVolume": {
      "properties": {
        "subpath": {
          "title": "Subpath",
          "type": "string"
        }
      },
      "title": "ServiceVolumeVolume",
      "type": "object"
    },
    "SourceTrialConfig": {
      "description": "A source trial this trial derives from.\n\n``action`` names the derivation and must be stated explicitly; only\n``regrade`` exists today. A ``hub`` source records only the hub trial\nUUID (the bytes are downloaded or read from the local cache); a\n``local`` source records the trial directory path plus its UUID when\nknown.",
      "properties": {
        "action": {
          "const": "regrade",
          "title": "Action",
          "type": "string"
        },
        "type": {
          "enum": [
            "local",
            "hub"
          ],
          "title": "Type",
          "type": "string"
        },
        "trial_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trial Id"
        },
        "path": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "action",
        "type"
      ],
      "title": "SourceTrialConfig",
      "type": "object"
    },
    "TaskConfig": {
      "properties": {
        "path": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "git_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Url"
        },
        "git_commit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "overwrite": {
          "default": false,
          "title": "Overwrite",
          "type": "boolean"
        },
        "download_dir": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Download Dir"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "title": "TaskConfig",
      "type": "object"
    },
    "TpuSpec": {
      "description": "Specification for a TPU slice attached to an environment.\n\nThe (type, topology) pair fully determines the GKE node pool the pod\nlands on *and* the per-pod TPU chip count, so there is no separate\nuser-facing chip-count field \u2014 it is derived via chip_count.",
      "properties": {
        "type": {
          "description": "TPU accelerator type. Accepts either a user-friendly alias (e.g., 'v6e', 'trillium', 'v4') or a canonical GKE label (e.g., 'tpu-v6e-slice', 'tpu7x').",
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "topology": {
          "description": "TPU topology as 'NxM' or 'NxMxK' (e.g., '2x4', '2x2x1').",
          "title": "Topology",
          "type": "string"
        }
      },
      "required": [
        "type",
        "topology"
      ],
      "title": "TpuSpec",
      "type": "object"
    },
