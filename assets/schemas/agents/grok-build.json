{
  "additionalProperties": false,
  "properties": {
    "version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Agent CLI version to install. Omit for latest.",
      "title": "Version"
    },
    "prompt_template_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Jinja2 template path; must include {{ instruction }}.",
      "title": "Prompt Template Path"
    },
    "config": {
      "default": null,
      "description": "Native config file path or inline JSON.",
      "title": "Config"
    },
    "max_turns": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Maximum agent turns.",
      "title": "Max Turns"
    },
    "reasoning_effort": {
      "anyOf": [
        {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Model reasoning effort.",
      "title": "Reasoning Effort"
    },
    "grok_config": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Grok config.toml overlay.",
      "title": "Grok Config"
    },
    "disable_web_search": {
      "default": true,
      "description": "Disable the server-side web search tool.",
      "title": "Disable Web Search",
      "type": "boolean"
    },
    "background_wait_sec": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 600,
      "description": "Seconds to wait on background tasks.",
      "title": "Background Wait Sec"
    },
    "kill_leftover_processes": {
      "default": true,
      "description": "Kill leftover child processes after the run.",
      "title": "Kill Leftover Processes",
      "type": "boolean"
    }
  },
  "title": "GrokBuildOptions",
  "type": "object",
  "x-native-config": true
}
