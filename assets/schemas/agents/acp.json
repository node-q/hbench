{
  "$defs": {
    "AcpAgentSource": {
      "additionalProperties": false,
      "description": "Config-supplied git source for a sandboxed ACP agent.\n\nTravels through ``agent.kwargs.source`` like any other agent option. The\nagent fetches the repository itself with the local user's git credentials.\nA full commit SHA pins the source for reproducible runs; mutable branch and\ntag refs are allowed for local development, resolved at fetch time, and may\nproduce different source across runs. Hosted deployments should supply an\nindependently verified, immutable source checkout. Repository code is never\nimported or executed on the manager.",
      "properties": {
        "repo_url": {
          "title": "Repo Url",
          "type": "string"
        },
        "ref": {
          "description": "Git ref to fetch. Use a full commit SHA for reproducible runs; branches and tags are resolved at fetch time.",
          "title": "Ref",
          "type": "string"
        },
        "source_dir": {
          "default": ".",
          "title": "Source Dir",
          "type": "string"
        },
        "manifest_path": {
          "default": "hbench-agent.json",
          "title": "Manifest Path",
          "type": "string"
        },
        "manifest_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Sha256"
        }
      },
      "required": [
        "repo_url",
        "ref"
      ],
      "title": "AcpAgentSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Agent CLI version to install. Omit for latest.",
      "title": "Version"
    },
    "prompt_template_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Jinja2 template path; must include {{ instruction }}.",
      "title": "Prompt Template Path"
    },
    "config": {
      "default": null,
      "description": "Native config file path or inline JSON.",
      "title": "Config"
    },
    "registry_entry": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Inline ACP registry entry.",
      "title": "Registry Entry"
    },
    "registry_entry_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Path to an ACP registry entry file.",
      "title": "Registry Entry Path"
    },
    "registry_spec": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ACP registry spec or shorthand.",
      "title": "Registry Spec"
    },
    "registry_ref": {
      "default": "main",
      "description": "ACP registry git ref.",
      "title": "Registry Ref",
      "type": "string"
    },
    "registry_cache_dir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "format": "path",
          "type": "string"
        }
      ],
      "default": ".cache/acp-registry",
      "description": "Local ACP registry cache.",
      "title": "Registry Cache Dir"
    },
    "distribution_preference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Preferred ACP distribution kinds.",
      "title": "Distribution Preference"
    },
    "permission_mode": {
      "default": "allow",
      "description": "ACP permission mode.",
      "enum": [
        "allow",
        "deny"
      ],
      "title": "Permission Mode",
      "type": "string"
    },
    "authenticate_method_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ACP authenticate method id.",
      "title": "Authenticate Method Id"
    },
    "auth_policy": {
      "anyOf": [
        {
          "enum": [
            "auto",
            "explicit",
            "disabled"
          ],
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "default": "auto",
      "description": "ACP authentication policy.",
      "title": "Auth Policy"
    },
    "target_platform": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ACP binary target platform.",
      "title": "Target Platform"
    },
    "source": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "$ref": "#/$defs/AcpAgentSource"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ACP git source instead of a registry entry.",
      "title": "Source"
    }
  },
  "title": "AcpOptions",
  "type": "object"
}
