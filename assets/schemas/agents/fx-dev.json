{
  "additionalProperties": false,
  "properties": {
    "version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Agent CLI version to install. Omit for latest.",
      "title": "Version"
    },
    "prompt_template_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Jinja2 template path; must include {{ instruction }}.",
      "title": "Prompt Template Path"
    },
    "config": {
      "default": null,
      "description": "Native config file path or inline JSON.",
      "title": "Config"
    },
    "max_agent_steps": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Maximum agent steps.",
      "title": "Max Agent Steps"
    },
    "reasoning_effort": {
      "anyOf": [
        {
          "enum": [
            "auto",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Model reasoning effort.",
      "title": "Reasoning Effort"
    },
    "permission_mode": {
      "anyOf": [
        {
          "enum": [
            "ask",
            "auto",
            "yolo"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "yolo",
      "description": "Permission mode.",
      "title": "Permission Mode"
    },
    "trace_log": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "/logs/agent/fx-trace.log",
      "description": "Path for fx-dev trace logs.",
      "title": "Trace Log"
    },
    "trace_scopes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "agent,core,gateway,stream,tool,session,permission,worker,command_output",
      "description": "Comma-separated fx-dev trace scopes.",
      "title": "Trace Scopes"
    }
  },
  "title": "FxDevOptions",
  "type": "object"
}
