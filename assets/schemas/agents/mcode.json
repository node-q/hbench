          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Provider API format.",
      "title": "Api Format"
    },
    "context_window": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Model context window tokens.",
      "title": "Context Window"
    },
    "max_output_tokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Maximum output tokens.",
      "title": "Max Output Tokens"
    },
    "permission_mode": {
      "default": "full",
      "description": "MCode permission mode.",
      "enum": [
        "ask",
        "smart",
        "full",
        "off"
      ],
      "title": "Permission Mode",
      "type": "string"
    }
